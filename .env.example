# Discord application
DISCORD_PUBLIC_KEY=
DISCORD_APPLICATION_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=

# Optional: register commands to one guild instantly during development.
DISCORD_GUILD_ID=

# Canonical public URL for wallet-link callbacks. Optional when request origin is correct.
HORRIS_DISCORD_PUBLIC_URL=

# Wallet-link HMAC secret. If omitted, DISCORD_CLIENT_SECRET is used as the server-only fallback.
WALLET_LINK_SECRET=

# Persistent wallet-link storage. Vercel KV / Upstash Redis REST variables are supported.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Or:
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Canonical Horris Core API. Keep Discord as an interface, not a second policy engine.
HORRIS_API_BASE_URL=https://horris-delta.vercel.app

# External wallet-review handoff. Discord never receives wallet secrets.
HORRIS_TERMINAL_URL=https://horris-delta.vercel.app/terminal
